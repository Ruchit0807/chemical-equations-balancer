---
import Layout from '../../layouts/Layout.astro';
import { languages, defaultLang, type Lang } from '../../i18n/ui';
import { useTranslatedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[])
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={`About Us - Chemical Equation Balancer (${languages[lang]})`}
  description="Learn about Balance Chemical Equation: our mission, 100% client-side matrix balancing engine, IUPAC scientific standards, and educational commitment."
  currentPath="/about-us"
  lang={lang}
>
  <div class="relative py-8 sm:py-12 md:py-20 border-b border-[#ebebeb] dark:border-[#262626] overflow-hidden">
    <!-- Hero Mesh Glow -->
    <div class="absolute inset-0 hero-mesh-gradient pointer-events-none opacity-60"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-mono text-[#8f8f8f] dark:text-[#737373] mb-4 sm:mb-6">
        <a href={translatePath('/')} class="hover:text-[#171717] dark:hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#171717] dark:text-[#ededed] font-medium">About Us</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] text-[11px] sm:text-xs font-mono font-medium mb-4 shadow-[0px_1px_1px_rgba(0,0,0,0.04)]">
        <span class="w-2 h-2 rounded-full bg-[#0070f3] animate-pulse shrink-0"></span>
        <span>MISSION & SCIENTIFIC FOUNDATION</span>
      </div>

      <h1 class="text-[28px] sm:text-5xl font-semibold tracking-tight sm:tracking-[-1.5px] text-[#171717] dark:text-white leading-tight">
        Engineered for Mathematical & Chemical Precision
      </h1>
      <p class="mt-3 sm:mt-4 text-sm sm:text-lg text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        <strong>Balance Chemical Equation</strong> was founded to eliminate the guesswork from chemistry problem-solving. We build engineering-grade educational tools that combine exact linear algebra, IUPAC standard atomic weights, and lightning-fast client-side computing.
      </p>
    </div>
  </div>

  <!-- Content Section -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10 sm:space-y-16">
    <!-- Origin Story -->
    <section class="space-y-4">
      <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0070f3]">
        01 / The Challenge & Solution
      </div>
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
        Moving Beyond Trial-and-Error Balancing
      </h2>
      <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        For generations, students and educators have been taught the traditional "inspection method" to balance chemical equations. While suitable for simple reactions like the synthesis of water, inspection quickly falls apart when tackling complex redox reactions, photosynthesis, carbohydrate combustion, or reactions involving polyatomic ions.
      </p>
      <p class="text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
        Our platform replaces subjective trial-and-error with <strong>exact rational Gaussian matrix reduction</strong>. By converting each chemical element into a linear conservation equation, our engine calculates the exact integer nullspace basis in milliseconds, guaranteeing mathematically sound, coprime whole-number coefficients every single time.
      </p>
    </section>

    <!-- Core Pillars Grid -->
    <section class="space-y-5 sm:space-y-6">
      <div class="text-xs font-mono font-semibold uppercase tracking-wider text-[#0070f3]">
        02 / Engineering Pillars
      </div>
      <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-[#171717] dark:text-white">
        What Sets Us Apart
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 pt-1 sm:pt-2">
        <div class="p-4 sm:p-6 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_2px_rgba(0,0,0,0.04)] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-[#0070f3]/10 dark:bg-[#0070f3]/20 text-[#0070f3] flex items-center justify-center font-mono font-bold text-lg">
            ⚡
          </div>
          <h3 class="text-base font-semibold text-[#171717] dark:text-white">100% Client-Side Architecture</h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Every calculation—equation balancing, molar masses, atom inventory audits, and limiting reagents—runs entirely inside your browser. No server lag, zero cloud downtime, and 100% privacy for student coursework and lab data.
          </p>
        </div>

        <div class="p-4 sm:p-6 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_2px_rgba(0,0,0,0.04)] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-mono font-bold text-lg">
            ∑
          </div>
          <h3 class="text-base font-semibold text-[#171717] dark:text-white">Exact Rational Arithmetic</h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            We avoid floating-point approximations (`0.1 + 0.2 ≠ 0.3`). Our solver relies on arbitrary-precision rational fractions with automatic Least Common Multiple (LCM) scaling to deliver perfect integer coefficients without rounding artifacts.
          </p>
        </div>

        <div class="p-4 sm:p-6 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_2px_rgba(0,0,0,0.04)] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-mono font-bold text-lg">
            ⚖
          </div>
          <h3 class="text-base font-semibold text-[#171717] dark:text-white">IUPAC Standard Compliance</h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            Our 118-element periodic database is calibrated against the 2024 Commission on Isotopic Abundances and Atomic Weights (CIAAW) IUPAC values, guaranteeing scientific fidelity across all stoichiometric computations.
          </p>
        </div>

        <div class="p-4 sm:p-6 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_2px_rgba(0,0,0,0.04)] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-mono font-bold text-lg">
            🎓
          </div>
          <h3 class="text-base font-semibold text-[#171717] dark:text-white">Pedagogical Step-by-Step Guidance</h3>
          <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed">
            We believe an educational tool should not merely spit out answers. Our system breaks down the algebra, shows element conservation equations, audits atom inventory on both sides, and explains reaction classifications.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to action card -->
    <div class="p-5 sm:p-8 rounded-2xl bg-gradient-to-r from-[#0070f3]/10 via-[#7928ca]/10 to-[#ff0080]/10 border border-[#0070f3]/20 flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-lg font-semibold text-[#171717] dark:text-white">Ready to balance reactions?</h3>
        <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1]">
          Explore our free online balancer, interactive periodic table, and stoichiometry tools.
        </p>
      </div>
      <a
        href={translatePath('/#balancer')}
        class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center text-sm font-medium text-white bg-[#0070f3] hover:bg-[#0761d1] px-5 py-2.5 rounded-full transition-colors shadow-sm whitespace-nowrap shrink-0"
      >
        Open Equation Balancer →
      </a>
    </div>
  </div>
</Layout>

