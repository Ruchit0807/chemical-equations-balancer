---
import Layout from '../layouts/Layout.astro';
import PeriodicDrawer from '../components/PeriodicDrawer.astro';
import BalancedEquationSection from '../components/BalancedEquationSection.astro';
import ReactionExamplesSection from '../components/ReactionExamplesSection.astro';
import ChemistryGuideAndFaq from '../components/ChemistryGuideAndFaq.astro';
---

<Layout>
  <!-- Hero Section with Mesh Gradient -->
  <section id="balancer" class="relative pt-12 pb-16 md:pt-20 md:pb-24 overflow-hidden border-b border-[#ebebeb]">
    <!-- Hero Mesh Gradient Background Glow -->
    <div class="absolute inset-0 hero-mesh-gradient pointer-events-none opacity-80"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Technical Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-[#ebebeb] text-[#171717] text-xs font-mono font-medium mb-6 shadow-[0px_1px_1px_rgba(0,0,0,0.04)]">
        <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
        <span>ENGINEERING-GRADE STOICHIOMETRY ENGINE</span>
        <span class="text-[#8f8f8f]">|</span>
        <span class="text-[#8f8f8f]">EXACT RATIONAL SOLVER</span>
      </div>

      <!-- Main Headline (Tight negative tracking per DESIGN.md) -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-semibold text-[#171717] tracking-[-2.4px] leading-tight sm:leading-[1.1]">
        Balance Chemical Equations <br class="hidden sm:inline" />
        <span class="text-[#4d4d4d]">with Live Stoichiometry</span>
      </h1>

      <p class="mt-4 text-sm sm:text-base text-[#4d4d4d] max-w-2xl mx-auto leading-relaxed">
        Input unbalanced chemical formulas via keyboard or interactive periodic table. Calculate smallest integer coefficients, view step-by-step matrix derivations, and explore bidirectional mole & mass conversions.
      </p>

      <!-- Main Input Box Surface -->
      <div class="mt-8 max-w-3xl mx-auto">
        <form id="equation-form" class="relative">
          <div class="p-2 sm:p-2.5 rounded-2xl bg-white border border-[#ebebeb] shadow-[0px_4px_16px_rgba(0,0,0,0.04)] flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
            <div class="relative flex-1 flex items-center">
              <span class="pl-3.5 pr-1 text-[#8f8f8f] font-mono text-sm select-none">⇌</span>
              <input
                type="text"
                id="equation-input"
                name="equation"
                placeholder="e.g. KMnO4 + HCl -> KCl + MnCl2 + Cl2 + H2O"
                autocomplete="off"
                spellcheck="false"
                class="w-full h-11 px-2.5 text-base sm:text-lg font-mono font-medium text-[#171717] placeholder:text-[#a1a1a1] bg-transparent focus:outline-none"
              />
              <button
                type="button"
                id="clear-input-btn"
                class="hidden mr-2 p-1 text-[#8f8f8f] hover:text-[#171717] rounded-full hover:bg-[#f2f2f2] transition-colors"
                title="Clear input"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <button
              type="submit"
              id="submit-balance-btn"
              class="h-11 px-6 rounded-full bg-[#171717] hover:bg-[#333333] text-white font-medium text-sm flex items-center justify-center gap-2 transition-all shadow-sm active:scale-[0.98] cursor-pointer"
            >
              <span>Balance Equation</span>
              <span class="font-mono text-xs">↵</span>
            </button>
          </div>
        </form>

        <!-- Error Notification Toast/Card -->
        <div id="error-card" class="hidden mt-3 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-left flex items-start gap-3 text-xs text-rose-800">
          <svg class="w-4 h-4 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div id="error-message" class="flex-1 font-mono">
            <!-- Dynamic error message -->
          </div>
        </div>

        <!-- Quick Demo Reaction Pills -->
        <div class="mt-4 flex flex-wrap items-center justify-center gap-1.5 text-xs text-[#4d4d4d]">
          <span class="font-mono text-[11px] text-[#8f8f8f] mr-1">Try examples:</span>
          <button type="button" class="quick-pill-btn px-2.5 py-1 rounded-full bg-white hover:bg-[#171717] hover:text-white border border-[#ebebeb] text-[11px] font-mono transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.02)]" data-eq="H2 + O2 -> H2O">
            H2 + O2
          </button>
          <button type="button" class="quick-pill-btn px-2.5 py-1 rounded-full bg-white hover:bg-[#171717] hover:text-white border border-[#ebebeb] text-[11px] font-mono transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.02)]" data-eq="CH4 + O2 -> CO2 + H2O">
            CH4 + O2 (Combustion)
          </button>
          <button type="button" class="quick-pill-btn px-2.5 py-1 rounded-full bg-white hover:bg-[#171717] hover:text-white border border-[#ebebeb] text-[11px] font-mono transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.02)]" data-eq="Al + Fe2O3 -> Al2O3 + Fe">
            Thermite
          </button>
          <button type="button" class="quick-pill-btn px-2.5 py-1 rounded-full bg-white hover:bg-[#171717] hover:text-white border border-[#ebebeb] text-[11px] font-mono transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.02)]" data-eq="KMnO4 + HCl -> KCl + MnCl2 + Cl2 + H2O">
            KMnO4 + HCl (Redox)
          </button>
          <button type="button" class="quick-pill-btn px-2.5 py-1 rounded-full bg-white hover:bg-[#171717] hover:text-white border border-[#ebebeb] text-[11px] font-mono transition-colors shadow-[0px_1px_1px_rgba(0,0,0,0.02)]" data-eq="Fe^2+ + Cr2O7^2- + H+ -> Fe^3+ + Cr^3+ + H2O">
            Ionic Redox (Charges)
          </button>
        </div>

        <!-- Chemistry Keypad & Periodic Table Insert Drawer -->
        <PeriodicDrawer />
      </div>
    </div>
  </section>

  <!-- Results Section: Balanced Equation, Stoichiometry, Atom Audit, Steps -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <BalancedEquationSection />
    <ReactionExamplesSection />
    <ChemistryGuideAndFaq />
  </div>
</Layout>

<script>
  import { balanceEquation, type BalancedResult } from '../lib/chemistry/solver';
  import { classifyReaction } from '../lib/chemistry/classifier';
  import {
    buildStoichiometricProfiles,
    calculateReactionQuantitiesFromMoles,
    calculateLimitingReagent,
    convertToMoles,
    type CompoundStoichProfile,
    type StoichiometryUnit
  } from '../lib/chemistry/stoichiometry';
  import { ELEMENTS_DATA } from '../lib/chemistry/elements';

  // State
  let currentResult: BalancedResult | null = null;
  let currentProfiles: CompoundStoichProfile[] = [];
  let stoichActiveIndex = 0;
  let stoichActiveAmount = 100;
  let stoichActiveUnit: StoichiometryUnit = 'g';

  // DOM Elements
  const equationForm = document.getElementById('equation-form') as HTMLFormElement;
  const equationInput = document.getElementById('equation-input') as HTMLInputElement;
  const clearInputBtn = document.getElementById('clear-input-btn') as HTMLButtonElement;
  const errorCard = document.getElementById('error-card') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLDivElement;
  const resultsWrapper = document.getElementById('results-wrapper') as HTMLDivElement;

  // Primary Output Elements
  const equationDisplay = document.getElementById('equation-display-container') as HTMLDivElement;
  const reactionTypeBadge = document.getElementById('reaction-type-badge') as HTMLSpanElement;
  const reactionTypeExplanation = document.getElementById('reaction-type-explanation') as HTMLParagraphElement;
  const atomAuditTbody = document.getElementById('atom-audit-tbody') as HTMLTableSectionElement;
  const massBalancePill = document.getElementById('mass-balance-pill') as HTMLDivElement;
  const stepsList = document.getElementById('steps-list') as HTMLDivElement;

  // Stoichiometry Elements
  const modeProportionalBtn = document.getElementById('mode-proportional-btn') as HTMLButtonElement;
  const modeLimitingBtn = document.getElementById('mode-limiting-btn') as HTMLButtonElement;
  const proportionalView = document.getElementById('proportional-view') as HTMLDivElement;
  const limitingView = document.getElementById('limiting-view') as HTMLDivElement;
  const stoichiometryTbody = document.getElementById('stoichiometry-tbody') as HTMLTableSectionElement;
  const limitingReactantsGrid = document.getElementById('limiting-reactants-grid') as HTMLDivElement;
  const limitingResultsContainer = document.getElementById('limiting-results-container') as HTMLDivElement;
  const actualYieldInput = document.getElementById('actual-yield-input') as HTMLInputElement;
  const percentYieldBadge = document.getElementById('percent-yield-badge') as HTMLDivElement;

  // Keypad & Periodic Table Elements
  const toggleFullPtBtn = document.getElementById('toggle-full-pt-btn') as HTMLButtonElement;
  const fullPtDrawer = document.getElementById('full-periodic-table-drawer') as HTMLDivElement;
  const ptBtnText = document.getElementById('pt-btn-text') as HTMLSpanElement;
  const ptBtnIcon = document.getElementById('pt-btn-icon') as unknown as SVGElement;
  const elementSearchInput = document.getElementById('element-search-input') as HTMLInputElement;
  const keypadBackspaceBtn = document.getElementById('keypad-backspace-btn') as HTMLButtonElement;
  const keypadClearBtn = document.getElementById('keypad-clear-btn') as HTMLButtonElement;

  // Copy & Action Buttons
  const copyEquationBtn = document.getElementById('copy-equation-btn') as HTMLButtonElement;
  const copyBtnText = document.getElementById('copy-btn-text') as HTMLSpanElement;
  const copyLatexBtn = document.getElementById('copy-latex-btn') as HTMLButtonElement;
  const shareLinkBtn = document.getElementById('share-link-btn') as HTMLButtonElement;
  const shareBtnText = document.getElementById('share-btn-text') as HTMLSpanElement;
  const toggleStepsBtn = document.getElementById('toggle-steps-accordion-btn') as HTMLButtonElement;
  const stepsContent = document.getElementById('steps-accordion-content') as HTMLDivElement;
  const stepsChevron = document.getElementById('steps-chevron') as unknown as SVGElement;

  // Core Function: Execute Balancing
  function runBalance(rawQuery?: string) {
    const query = (rawQuery !== undefined ? rawQuery : equationInput.value).trim();
    if (!query) return;

    equationInput.value = query;
    clearInputBtn.classList.remove('hidden');

    const result = balanceEquation(query);

    if (!result.success) {
      errorCard.classList.remove('hidden');
      errorMessage.textContent = result.error || 'Failed to balance equation. Please check formulas.';
      resultsWrapper.classList.add('hidden');
      return;
    }

    // Success: hide error, show results
    errorCard.classList.add('hidden');
    resultsWrapper.classList.remove('hidden');
    currentResult = result;

    // 1. Render primary equation
    renderPrimaryEquation(result);

    // 2. Render classification
    const classification = classifyReaction(
      result.reactants.map((r) => r.compound),
      result.products.map((p) => p.compound)
    );
    reactionTypeBadge.textContent = classification.primaryType;
    reactionTypeExplanation.textContent = classification.explanation;

    // 3. Render Atom Audit table & mass conservation
    renderAtomAudit(result);

    // 4. Render Step-by-Step explanation
    renderSteps(result);

    // 5. Initialize Stoichiometry Profiles
    currentProfiles = buildStoichiometricProfiles(result.reactants, result.products);
    stoichActiveIndex = 0;
    stoichActiveAmount = 100;
    stoichActiveUnit = 'g';

    renderStoichiometryTable();
    renderLimitingReagentView();

    // Smooth scroll to results if user initiated balance
    resultsWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Update URL query param without reload
    const url = new URL(window.location.href);
    url.searchParams.set('eq', query);
    window.history.replaceState({}, '', url.toString());
  }

  function renderPrimaryEquation(res: BalancedResult) {
    // Format reaction equation display with colored coefficient badges
    const formatTerms = (list: typeof res.reactants) => {
      return list
        .map((item) => {
          const coeffSpan =
            item.coefficient > 1
              ? `<span class="inline-block px-1.5 py-0.5 rounded font-bold text-[#0070f3] bg-[#d3e5ff]/50 border border-[#0070f3]/20 mr-1">${item.coefficient}</span>`
              : '';
          const phaseSpan = item.compound.phase
            ? `<span class="text-xs text-[#8f8f8f] font-normal ml-0.5">(${item.compound.phase})</span>`
            : '';
          return `<span class="inline-flex items-baseline">${coeffSpan}<span>${item.htmlFormula}</span>${phaseSpan}</span>`;
        })
        .join('<span class="mx-2 text-[#8f8f8f] font-normal">+</span>');
    };

    const lhsHtml = formatTerms(res.reactants);
    const rhsHtml = formatTerms(res.products);

    equationDisplay.innerHTML = `${lhsHtml} <span class="mx-3 text-[#171717] font-semibold">→</span> ${rhsHtml}`;
  }

  function renderAtomAudit(res: BalancedResult) {
    let rowsHtml = '';
    let totalLhsMass = 0;
    let totalRhsMass = 0;

    for (const elem of res.allElements) {
      const elData = ELEMENTS_DATA.find((e) => e.symbol === elem);
      const name = elData ? elData.name : elem;
      const mass = elData ? elData.mass : 0;

      let lhsCount = 0;
      for (const r of res.reactants) {
        lhsCount += (r.compound.elementCounts[elem] || 0) * r.coefficient;
      }

      let rhsCount = 0;
      for (const p of res.products) {
        rhsCount += (p.compound.elementCounts[elem] || 0) * p.coefficient;
      }

      totalLhsMass += lhsCount * mass;
      totalRhsMass += rhsCount * mass;

      rowsHtml += `
        <tr class="hover:bg-[#fafafa] transition-colors">
          <td class="py-2.5 font-mono font-semibold text-[#171717]">${elem}</td>
          <td class="py-2.5 text-[#4d4d4d]">${name}</td>
          <td class="py-2.5 font-mono text-center font-medium text-[#171717]">${lhsCount}</td>
          <td class="py-2.5 text-center text-[#8f8f8f] font-mono">=</td>
          <td class="py-2.5 font-mono text-center font-medium text-[#171717]">${rhsCount}</td>
          <td class="py-2.5 font-mono text-[#4d4d4d]">${mass.toFixed(3)} g/mol</td>
          <td class="py-2.5 text-right font-mono text-emerald-600 font-medium">✓ Equal</td>
        </tr>
      `;
    }

    atomAuditTbody.innerHTML = rowsHtml;
    massBalancePill.innerHTML = `LHS: ${totalLhsMass.toFixed(2)} g/mol = RHS: ${totalRhsMass.toFixed(2)} g/mol ✓`;
  }

  function renderSteps(res: BalancedResult) {
    let stepsHtml = '';
    res.steps.forEach((step) => {
      stepsHtml += `
        <div class="p-4 rounded-lg bg-[#fafafa] border border-[#ebebeb]">
          <h4 class="font-semibold text-[#171717] mb-1">${step.title}</h4>
          <p class="text-[#4d4d4d] mb-2 leading-relaxed">${step.description}</p>
          ${
            step.math
              ? `<pre class="p-2.5 rounded bg-white border border-[#ebebeb] font-mono text-xs text-[#171717] overflow-x-auto whitespace-pre-wrap">${step.math}</pre>`
              : ''
          }
        </div>
      `;
    });
    stepsList.innerHTML = stepsHtml;
  }

  // Stoichiometry Table Rendering (Proportional View)
  function renderStoichiometryTable() {
    if (!currentProfiles.length) return;

    // Calculate quantities based on active substance
    const activeProfile = currentProfiles[stoichActiveIndex];
    const activeMoles = convertToMoles(stoichActiveAmount, stoichActiveUnit, activeProfile.molarMass);
    const calculated = calculateReactionQuantitiesFromMoles(currentProfiles, stoichActiveIndex, activeMoles);

    let html = '';
    calculated.forEach((item, index) => {
      const p = item.profile;
      const isSelected = index === stoichActiveIndex;
      const isReactant = p.isReactant;

      html += `
        <tr class="hover:bg-[#fafafa] transition-colors ${isSelected ? 'bg-[#0070f3]/5' : ''}">
          <td class="py-3 font-mono">
            <span class="px-2 py-0.5 rounded text-[10px] uppercase font-semibold ${
              isReactant ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
            }">
              ${isReactant ? 'Reactant' : 'Product'}
            </span>
          </td>
          <td class="py-3 font-mono font-semibold text-[#171717] text-sm">
            ${p.coefficient > 1 ? `<span class="text-[#0070f3]">${p.coefficient}</span> ` : ''}${p.cleanFormula}
          </td>
          <td class="py-3 font-mono text-[#4d4d4d]">
            ${p.coefficient} mol
          </td>
          <td class="py-3 font-mono text-[#4d4d4d]">
            ${p.molarMass.toFixed(3)} g/mol
          </td>
          <td class="py-3">
            <div class="flex items-center gap-1.5">
              <input
                type="number"
                step="any"
                data-stoich-index="${index}"
                value="${isSelected ? stoichActiveAmount : (stoichActiveUnit === 'g' ? item.massGrams.toFixed(2) : (stoichActiveUnit === 'mol' ? item.moles.toFixed(3) : item.massGrams.toFixed(2)))}"
                class="stoich-amount-input w-24 h-7 px-2 text-xs font-mono bg-white border border-[#ebebeb] rounded focus:outline-none focus:border-[#171717] ${isSelected ? 'border-[#0070f3] ring-1 ring-[#0070f3]' : ''}"
              />
              <select
                data-stoich-unit-index="${index}"
                class="stoich-unit-select h-7 px-1.5 text-xs font-mono bg-white border border-[#ebebeb] rounded text-[#4d4d4d] focus:outline-none"
              >
                <option value="g" ${stoichActiveUnit === 'g' ? 'selected' : ''}>g</option>
                <option value="kg" ${stoichActiveUnit === 'kg' ? 'selected' : ''}>kg</option>
                <option value="mg" ${stoichActiveUnit === 'mg' ? 'selected' : ''}>mg</option>
                <option value="mol" ${stoichActiveUnit === 'mol' ? 'selected' : ''}>mol</option>
                <option value="mmol" ${stoichActiveUnit === 'mmol' ? 'selected' : ''}>mmol</option>
                <option value="L" ${stoichActiveUnit === 'L' ? 'selected' : ''}>L (STP)</option>
              </select>
            </div>
          </td>
          <td class="py-3 font-mono text-[#171717] font-medium">
            ${item.moles.toFixed(4)}
          </td>
          <td class="py-3 font-mono text-[#171717] font-medium">
            ${item.massGrams.toFixed(2)}
          </td>
          <td class="py-3 font-mono text-[#4d4d4d]">
            ${item.volumeStpLiters.toFixed(2)}
          </td>
        </tr>
      `;
    });

    stoichiometryTbody.innerHTML = html;

    // Attach reactive listeners to input fields in table
    const inputs = stoichiometryTbody.querySelectorAll('.stoich-amount-input');
    inputs.forEach((input) => {
      input.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const idx = parseInt(target.getAttribute('data-stoich-index') || '0', 10);
        const val = parseFloat(target.value);
        if (!isNaN(val) && val >= 0) {
          stoichActiveIndex = idx;
          stoichActiveAmount = val;
          renderStoichiometryTable();
        }
      });
    });

    const selects = stoichiometryTbody.querySelectorAll('.stoich-unit-select');
    selects.forEach((sel) => {
      sel.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const idx = parseInt(target.getAttribute('data-stoich-unit-index') || '0', 10);
        stoichActiveIndex = idx;
        stoichActiveUnit = target.value as StoichiometryUnit;
        renderStoichiometryTable();
      });
    });
  }

  // Limiting Reagent View Rendering
  function renderLimitingReagentView() {
    const reactants = currentProfiles.filter((p) => p.isReactant);
    if (!reactants.length) return;

    let inputsHtml = '';
    reactants.forEach((r, i) => {
      inputsHtml += `
        <div class="p-4 rounded-xl bg-white border border-[#ebebeb] shadow-[0px_1px_1px_rgba(0,0,0,0.02)]">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-semibold text-[#171717]">${r.cleanFormula}</span>
            <span class="text-[11px] font-mono text-[#8f8f8f]">${r.molarMass.toFixed(2)} g/mol</span>
          </div>
          <label class="block text-[11px] text-[#8f8f8f] mb-1">Available Quantity:</label>
          <div class="flex items-center gap-1.5">
            <input
              type="number"
              step="any"
              data-limiting-input-index="${i}"
              value="${(i + 1) * 25}"
              class="limiting-amount-field w-full h-8 px-2.5 bg-[#fafafa] border border-[#ebebeb] rounded text-xs font-mono text-[#171717] focus:outline-none focus:border-[#171717]"
            />
            <select
              data-limiting-unit-index="${i}"
              class="limiting-unit-field h-8 px-2 bg-[#fafafa] border border-[#ebebeb] rounded text-xs font-mono text-[#4d4d4d] focus:outline-none"
            >
              <option value="g">g</option>
              <option value="mol">mol</option>
              <option value="kg">kg</option>
            </select>
          </div>
        </div>
      `;
    });

    limitingReactantsGrid.innerHTML = inputsHtml;

    // Attach listeners
    limitingReactantsGrid.querySelectorAll('.limiting-amount-field, .limiting-unit-field').forEach((el) => {
      el.addEventListener('input', updateLimitingCalculations);
      el.addEventListener('change', updateLimitingCalculations);
    });

    updateLimitingCalculations();
  }

  function updateLimitingCalculations() {
    const amountInputs = limitingReactantsGrid.querySelectorAll('.limiting-amount-field') as NodeListOf<HTMLInputElement>;
    const unitSelects = limitingReactantsGrid.querySelectorAll('.limiting-unit-field') as NodeListOf<HTMLSelectElement>;

    const inputs: { amount: number; unit: StoichiometryUnit }[] = [];
    amountInputs.forEach((inp, i) => {
      inputs.push({
        amount: parseFloat(inp.value) || 0,
        unit: (unitSelects[i].value as StoichiometryUnit) || 'g'
      });
    });

    const result = calculateLimitingReagent(currentProfiles, inputs);
    if (!result) {
      limitingResultsContainer.innerHTML = `
        <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-800 font-mono">
          Please enter positive available amounts for all reactants to calculate the limiting reactant.
        </div>
      `;
      return;
    }

    let resultsHtml = `
      <div class="p-4 rounded-xl bg-white border border-[#ebebeb] shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
          <span class="text-xs font-mono font-semibold uppercase text-[#171717]">
            Limiting Reactant Identified:
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800 text-xs font-mono font-bold">
            ${result.limitingProfile.cleanFormula}
          </span>
        </div>
        <p class="text-xs text-[#4d4d4d] leading-relaxed mb-4">
          <strong>${result.limitingProfile.cleanFormula}</strong> produces the least amount of product and will be 100% consumed first. It governs the maximum theoretical yield of the reaction.
        </p>

        <!-- Reactants Consumption Status Table -->
        <div class="overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead>
              <tr class="border-b border-[#ebebeb] text-[#8f8f8f] font-mono text-[11px]">
                <th class="pb-2 font-medium">Reactant</th>
                <th class="pb-2 font-medium">Initial Mass</th>
                <th class="pb-2 font-medium">Consumed</th>
                <th class="pb-2 font-medium">Excess Leftover</th>
                <th class="pb-2 font-medium">% Consumed</th>
                <th class="pb-2 font-medium text-right">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ebebeb]/60 font-mono">
              ${result.reactantsStatus
                .map(
                  (s) => `
                <tr class="hover:bg-[#fafafa]">
                  <td class="py-2.5 font-bold text-[#171717]">${s.profile.cleanFormula}</td>
                  <td class="py-2.5 text-[#4d4d4d]">${s.initialGrams.toFixed(2)} g</td>
                  <td class="py-2.5 text-[#4d4d4d]">${s.consumedGrams.toFixed(2)} g</td>
                  <td class="py-2.5 ${s.isLimiting ? 'text-[#8f8f8f]' : 'text-amber-700 font-semibold'}">
                    ${s.isLimiting ? '0.00 g (None)' : `${s.remainingGrams.toFixed(2)} g`}
                  </td>
                  <td class="py-2.5">${s.percentConsumed.toFixed(1)}%</td>
                  <td class="py-2.5 text-right font-semibold ${s.isLimiting ? 'text-rose-600' : 'text-amber-600'}">
                    ${s.isLimiting ? 'Limiting Reagent' : 'Excess Reagent'}
                  </td>
                </tr>
              `
                )
                .join('')}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Theoretical Yield of Products Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        ${result.theoreticalYields
          .map(
            (y) => `
          <div class="p-4 rounded-xl bg-white border border-[#ebebeb] shadow-[0px_1px_1px_rgba(0,0,0,0.02)]">
            <div class="text-[11px] font-mono text-[#8f8f8f] uppercase">Theoretical Yield (${y.profile.cleanFormula})</div>
            <div class="text-xl font-bold font-mono text-[#171717] mt-1">
              ${y.theoreticalGrams.toFixed(2)} <span class="text-sm font-normal text-[#8f8f8f]">grams</span>
            </div>
            <div class="text-xs font-mono text-[#4d4d4d] mt-1 flex items-center gap-3">
              <span>${y.theoreticalMoles.toFixed(4)} mol</span>
              <span>•</span>
              <span>${y.theoreticalLiters.toFixed(2)} L (STP)</span>
            </div>
          </div>
        `
          )
          .join('')}
      </div>
    `;

    limitingResultsContainer.innerHTML = resultsHtml;

    // Trigger percent yield calculation
    calcPercentYield(result.theoreticalYields[0]?.theoreticalGrams || 0);
  }

  function calcPercentYield(theoreticalGrams: number) {
    const actual = parseFloat(actualYieldInput.value);
    if (!isNaN(actual) && actual > 0 && theoreticalGrams > 0) {
      const pct = (actual / theoreticalGrams) * 100;
      percentYieldBadge.textContent = `Yield: ${pct.toFixed(1)}%`;
      percentYieldBadge.classList.remove('hidden');
    } else {
      percentYieldBadge.classList.add('hidden');
    }
  }

  // Keypad & Input Helpers
  function insertAtCursor(text: string) {
    const start = equationInput.selectionStart || equationInput.value.length;
    const end = equationInput.selectionEnd || equationInput.value.length;
    const val = equationInput.value;

    equationInput.value = val.substring(0, start) + text + val.substring(end);
    const newPos = start + text.length;
    equationInput.focus();
    equationInput.setSelectionRange(newPos, newPos);
    clearInputBtn.classList.remove('hidden');
  }

  function backspaceAtCursor() {
    const start = equationInput.selectionStart || equationInput.value.length;
    const end = equationInput.selectionEnd || equationInput.value.length;
    const val = equationInput.value;

    if (start === end && start > 0) {
      equationInput.value = val.substring(0, start - 1) + val.substring(end);
      equationInput.focus();
      equationInput.setSelectionRange(start - 1, start - 1);
    } else if (start !== end) {
      equationInput.value = val.substring(0, start) + val.substring(end);
      equationInput.focus();
      equationInput.setSelectionRange(start, start);
    }
    if (!equationInput.value) clearInputBtn.classList.add('hidden');
  }

  // Event Listeners
  equationForm.addEventListener('submit', (e) => {
    e.preventDefault();
    runBalance();
  });

  equationInput.addEventListener('input', () => {
    if (equationInput.value) clearInputBtn.classList.remove('hidden');
    else clearInputBtn.classList.add('hidden');
  });

  clearInputBtn.addEventListener('click', () => {
    equationInput.value = '';
    clearInputBtn.classList.add('hidden');
    equationInput.focus();
  });

  // Keypad Click-to-Insert Buttons
  document.querySelectorAll('.keypad-insert-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const insertStr = btn.getAttribute('data-insert') || '';
      insertAtCursor(insertStr);
    });
  });

  keypadBackspaceBtn.addEventListener('click', backspaceAtCursor);
  keypadClearBtn.addEventListener('click', () => {
    equationInput.value = '';
    clearInputBtn.classList.add('hidden');
    equationInput.focus();
  });

  // Toggle Full Periodic Table Drawer
  toggleFullPtBtn.addEventListener('click', () => {
    const isHidden = fullPtDrawer.classList.contains('hidden');
    if (isHidden) {
      fullPtDrawer.classList.remove('hidden');
      ptBtnText.textContent = 'Hide Periodic Table';
      ptBtnIcon.classList.add('rotate-180');
    } else {
      fullPtDrawer.classList.add('hidden');
      ptBtnText.textContent = 'Open Full Periodic Table';
      ptBtnIcon.classList.remove('rotate-180');
    }
  });

  // Element Search in Periodic Table
  elementSearchInput.addEventListener('input', () => {
    const query = elementSearchInput.value.toLowerCase().trim();
    const cards = document.querySelectorAll('.element-grid-card');

    cards.forEach((card) => {
      const sym = card.getAttribute('data-element-symbol') || '';
      const name = card.getAttribute('data-element-name') || '';
      const num = card.getAttribute('data-element-number') || '';

      if (!query || sym.includes(query) || name.includes(query) || num === query) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  });

  // Element Category Filters
  document.querySelectorAll('.category-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category-filter');
      const cards = document.querySelectorAll('.element-grid-card');

      document.querySelectorAll('.category-filter-btn').forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white');
        b.classList.add('bg-white', 'text-[#4d4d4d]');
      });
      btn.classList.add('bg-[#171717]', 'text-white');
      btn.classList.remove('bg-white', 'text-[#4d4d4d]');

      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-element-category');
        if (cat === 'all' || cardCat === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Mode Switch (Proportional vs Limiting)
  modeProportionalBtn.addEventListener('click', () => {
    stoichMode = 'proportional';
    modeProportionalBtn.classList.add('bg-white', 'text-[#171717]', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
    modeProportionalBtn.classList.remove('text-[#4d4d4d]');
    modeLimitingBtn.classList.remove('bg-white', 'text-[#171717]', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
    modeLimitingBtn.classList.add('text-[#4d4d4d]');

    proportionalView.classList.remove('hidden');
    limitingView.classList.add('hidden');
  });

  modeLimitingBtn.addEventListener('click', () => {
    stoichMode = 'limiting';
    modeLimitingBtn.classList.add('bg-white', 'text-[#171717]', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
    modeLimitingBtn.classList.remove('text-[#4d4d4d]');
    modeProportionalBtn.classList.remove('bg-white', 'text-[#171717]', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
    modeProportionalBtn.classList.add('text-[#4d4d4d]');

    limitingView.classList.remove('hidden');
    proportionalView.classList.add('hidden');
  });

  actualYieldInput.addEventListener('input', () => {
    const theoretical = currentProfiles.find((p) => !p.isReactant)?.molarMass || 100;
    calcPercentYield(theoretical);
  });

  // Quick Demo Pills
  document.querySelectorAll('.quick-pill-btn').forEach((pill) => {
    pill.addEventListener('click', () => {
      const eq = pill.getAttribute('data-eq') || '';
      runBalance(eq);
    });
  });

  // Load Example from Library
  document.querySelectorAll('.load-example-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const eq = btn.getAttribute('data-load-equation') || '';
      runBalance(eq);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  // Library Category Tabs
  document.querySelectorAll('.example-category-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-category');
      document.querySelectorAll('.example-category-btn').forEach((b) => {
        b.classList.remove('bg-[#171717]', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-[#4d4d4d]', 'border', 'border-[#ebebeb]');
      });
      btn.classList.add('bg-[#171717]', 'text-white', 'shadow-sm');
      btn.classList.remove('bg-white', 'text-[#4d4d4d]', 'border', 'border-[#ebebeb]');

      document.querySelectorAll('.example-card').forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (cat === 'All' || cardCat === cat) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Copy Formula Button
  copyEquationBtn.addEventListener('click', async () => {
    if (!currentResult) return;
    try {
      await navigator.clipboard.writeText(currentResult.balancedEquationString);
      copyBtnText.textContent = 'Copied!';
      setTimeout(() => {
        copyBtnText.textContent = 'Copy Formula';
      }, 2000);
    } catch {
      // Fallback
      copyBtnText.textContent = 'Copied!';
    }
  });

  // Copy LaTeX Button
  copyLatexBtn.addEventListener('click', async () => {
    if (!currentResult) return;
    try {
      await navigator.clipboard.writeText(currentResult.balancedEquationLatex);
      copyLatexBtn.innerHTML = '<span class="font-mono text-[11px] text-emerald-600">✓</span><span>Copied TeX</span>';
      setTimeout(() => {
        copyLatexBtn.innerHTML = '<span class="font-mono text-[11px] text-[#8f8f8f]">TeX</span><span>Copy LaTeX</span>';
      }, 2000);
    } catch {}
  });

  // Share Link Button
  shareLinkBtn.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      shareBtnText.textContent = 'Link Copied!';
      setTimeout(() => {
        shareBtnText.textContent = 'Share';
      }, 2000);
    } catch {}
  });

  // Toggle Steps Accordion
  toggleStepsBtn.addEventListener('click', () => {
    const isHidden = stepsContent.classList.contains('hidden');
    if (isHidden) {
      stepsContent.classList.remove('hidden');
      stepsChevron.classList.add('rotate-180');
    } else {
      stepsContent.classList.add('hidden');
      stepsChevron.classList.remove('rotate-180');
    }
  });

  // Check URL query param on initial load
  window.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);
    const eqParam = params.get('eq');
    if (eqParam) {
      runBalance(eqParam);
    } else {
      // Default initial balance: combustion of propane
      runBalance('C3H8 + O2 -> CO2 + H2O');
    }
  });
</script>
