---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Reaction Not Found | Balance Chemical Equation"
  description="The chemical page or reaction formula you are looking for could not be found or has undergone irreversible decomposition."
  noindex={true}
  currentPath="/404"
>
  <div class="relative py-10 sm:py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute inset-0 hero-mesh-gradient pointer-events-none opacity-60"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Technical Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-700 dark:text-rose-300 text-[11px] sm:text-xs font-mono font-medium mb-5 sm:mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping shrink-0"></span>
        <span>ERROR 404: REACTION_NOT_FOUND</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#171717] dark:text-white leading-none font-mono">
        404
      </h1>
      <p class="mt-4 text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">
        Chemical Reaction Equation Not Found
      </p>
      <p class="mt-3 text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-xl mx-auto leading-relaxed">
        The page or chemical resource you requested does not exist, has been relocated, or has undergone complete decomposition.
      </p>

      <!-- Chemistry Analogy Card -->
      <div class="mt-7 sm:mt-8 max-w-xl mx-auto p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_2px_8px_rgba(0,0,0,0.04)] text-left">
        <div class="flex flex-wrap items-center justify-between gap-1.5 text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] pb-2 mb-2 border-b border-[#f2f2f2] dark:border-[#1f1f1f]">
          <span>UNBALANCED DECOMPOSITION</span>
          <span class="text-rose-600 dark:text-rose-400 font-semibold">COEFFICIENT = UNDEFINED</span>
        </div>
        <div class="font-mono text-xs sm:text-sm text-[#171717] dark:text-white font-medium overflow-x-auto py-1">
          RequestedPage<span class="text-[#8f8f8f]">(aq)</span> + BrokenLink<span class="text-[#8f8f8f]">(s)</span> ⟶ <span class="text-rose-600 dark:text-rose-400 font-bold">404</span><span class="text-[#8f8f8f]">(g)</span> + Null<span class="text-[#8f8f8f]">(l)</span>
        </div>
        <div class="mt-2 text-[11px] text-[#8f8f8f] dark:text-[#737373] flex items-start sm:items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5 sm:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Law of Conservation of Information violated. Please restore reactants to a valid path.</span>
        </div>
      </div>

      <!-- Quick Chemical Equation Search Input -->
      <div class="mt-7 sm:mt-8 max-w-lg mx-auto">
        <form action="/" method="GET" class="relative">
          <div class="p-1.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] shadow-sm flex items-center gap-2">
            <span class="pl-3 text-[#0070f3] font-mono text-sm font-bold shrink-0">⇌</span>
            <input
              type="text"
              name="eq"
              placeholder="Search or enter equation (e.g. H2 + O2 -> H2O)..."
              class="w-full min-w-0 h-10 sm:h-9 px-2 text-base sm:text-sm font-mono text-[#171717] dark:text-white placeholder:text-[#a1a1a1] bg-transparent focus:outline-none"
              autocomplete="off"
            />
            <button
              type="submit"
              class="h-10 sm:h-9 px-4 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black text-xs font-semibold hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-colors cursor-pointer shrink-0"
            >
              Balance
            </button>
          </div>
        </form>
      </div>

      <!-- Quick Links Navigation Grid -->
      <div class="mt-7 sm:mt-8 flex flex-wrap items-center justify-center gap-2.5">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 min-h-[44px] sm:min-h-0 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-semibold text-xs sm:text-sm hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-all shadow-sm active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Return to Equation Balancer</span>
        </a>

        <a
          href="/#examples"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] font-medium text-xs sm:text-sm hover:border-[#171717] dark:hover:border-white transition-colors shadow-sm"
        >
          <span>Reaction Library</span>
          <span class="font-mono text-xs">→</span>
        </a>

        <a
          href="/#periodic-table-section"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] font-medium text-xs sm:text-sm hover:border-[#171717] dark:hover:border-white transition-colors shadow-sm"
        >
          <span>Periodic Table</span>
          <span class="font-mono text-xs">→</span>
        </a>

        <a
          href="/#stoichiometry"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] font-medium text-xs sm:text-sm hover:border-[#171717] dark:hover:border-white transition-colors shadow-sm"
        >
          <span>Stoichiometry Calculator</span>
          <span class="font-mono text-xs">→</span>
        </a>
      </div>

      <!-- Quick Reaction Launchers -->
      <div class="mt-8 pt-8 border-t border-[#f2f2f2] dark:border-[#1f1f1f] max-w-md mx-auto">
        <div class="text-xs font-mono text-[#8f8f8f] dark:text-[#737373] mb-2.5">
          Or try balancing one of these common reactions:
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2">
          <a
            href="/?eq=H2%20%2B%20O2%20-%3E%20H2O"
            class="px-3 py-1 rounded-full bg-white dark:bg-[#171717] hover:bg-[#171717] hover:text-white dark:hover:bg-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] text-xs font-mono transition-colors shadow-sm"
          >
            H2 + O2 → H2O
          </a>
          <a
            href="/?eq=CH4%20%2B%20O2%20-%3E%20CO2%20%2B%20H2O"
            class="px-3 py-1 rounded-full bg-white dark:bg-[#171717] hover:bg-[#171717] hover:text-white dark:hover:bg-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] text-xs font-mono transition-colors shadow-sm"
          >
            CH4 + O2 (Combustion)
          </a>
          <a
            href="/?eq=KMnO4%20%2B%20HCl%20-%3E%20KCl%20%2B%20MnCl2%20%2B%20Cl2%20%2B%20H2O"
            class="px-3 py-1 rounded-full bg-white dark:bg-[#171717] hover:bg-[#171717] hover:text-white dark:hover:bg-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] text-xs font-mono transition-colors shadow-sm"
          >
            KMnO4 + HCl (Redox)
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

