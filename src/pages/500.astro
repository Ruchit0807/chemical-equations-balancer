---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500 - Unstable Equilibrium | Balance Chemical Equation"
  description="An unexpected condition occurred while balancing the chemical equation or rendering the reaction chamber."
  noindex={true}
  currentPath="/500"
>
  <div class="relative py-16 md:py-24 border-b border-[#ebebeb] dark:border-[#262626] overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute inset-0 hero-mesh-gradient pointer-events-none opacity-60"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Technical Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 text-amber-800 dark:text-amber-300 text-xs font-mono font-medium mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
        <span>ERROR 500: UNSTABLE_EQUILIBRIUM_STATE</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#171717] dark:text-white leading-none font-mono">
        500
      </h1>
      <p class="mt-4 text-xl sm:text-2xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight">
        Internal Reaction Chamber Anomaly
      </p>
      <p class="mt-3 text-sm sm:text-base text-[#4d4d4d] dark:text-[#a1a1a1] max-w-xl mx-auto leading-relaxed">
        An unexpected equilibrium disruption interrupted the matrix solver. All chemical equation balancing occurs safely in your browser.
      </p>

      <!-- Chemistry Analogy Card -->
      <div class="mt-8 max-w-xl mx-auto p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_2px_8px_rgba(0,0,0,0.04)] text-left">
        <div class="flex items-center justify-between text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] pb-2 mb-2 border-b border-[#f2f2f2] dark:border-[#1f1f1f]">
          <span>STATE: THERMAL RUNAWAY</span>
          <span class="text-amber-600 dark:text-amber-400 font-semibold">LE CHATELIER SHIFT</span>
        </div>
        <div class="font-mono text-xs sm:text-sm text-[#171717] dark:text-white font-medium overflow-x-auto py-1">
          NormalState<span class="text-[#8f8f8f]">(aq)</span> + Anomaly<span class="text-[#8f8f8f]">(g)</span> ⇌ <span class="text-amber-600 dark:text-amber-400 font-bold">500_UnstableEquilibrium</span><span class="text-[#8f8f8f]">(crit)</span>
        </div>
        <div class="mt-2 text-[11px] text-[#8f8f8f] dark:text-[#737373] flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Reloading or resetting reaction conditions will re-establish thermodynamic ground state.</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button
          type="button"
          onclick="window.location.reload()"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#171717] dark:bg-white text-white dark:text-black font-semibold text-xs sm:text-sm hover:bg-[#333333] dark:hover:bg-[#e5e5e5] transition-all shadow-sm active:scale-95 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span>Reload Chamber (Retry)</span>
        </button>

        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#171717] dark:text-[#ededed] font-semibold text-xs sm:text-sm hover:border-[#171717] dark:hover:border-white transition-colors shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Return to Safe State (Home)</span>
        </a>

        <a
          href="/contact-us"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white font-medium text-xs sm:text-sm hover:border-[#171717] dark:hover:border-white transition-colors shadow-sm"
        >
          <span>Report Anomaly</span>
          <span class="font-mono text-xs">→</span>
        </a>
      </div>

      <!-- Helpful tips box -->
      <div class="mt-8 pt-8 border-t border-[#f2f2f2] dark:border-[#1f1f1f] max-w-md mx-auto text-xs text-[#8f8f8f] dark:text-[#737373] leading-relaxed">
        <strong>Tip:</strong> All calculations run 100% client-side in your browser using pure JavaScript and Web Standards. If this persists, try clearing temporary browser cache or disabling browser extensions that may block scripts.
      </div>
    </div>
  </div>
</Layout>
