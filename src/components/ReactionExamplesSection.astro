---
import { POPULAR_REACTIONS, REACTION_CATEGORIES } from '../lib/chemistry/examples';
---

<section id="examples" class="mt-20 scroll-mt-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-[#171717]"></span>
        <span class="text-xs font-mono font-medium uppercase text-[#8f8f8f] tracking-wider">
          Reaction Library
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] tracking-[-1.28px]">
        Popular Chemical Equations
      </h2>
      <p class="text-xs sm:text-sm text-[#4d4d4d] mt-1 max-w-xl">
        Click any verified chemical reaction below to instantly load its stoichiometric proportions, molar mass table, and balancing steps.
      </p>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 max-w-full text-xs">
      {REACTION_CATEGORIES.map((cat, i) => (
        <button
          type="button"
          data-category={cat}
          class={`example-category-btn px-3 py-1.5 rounded-full text-xs font-medium transition-all whitespace-nowrap ${
            i === 0
              ? 'bg-[#171717] text-white shadow-sm'
              : 'bg-white text-[#4d4d4d] border border-[#ebebeb] hover:border-[#171717]'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Reactions Grid -->
  <div id="examples-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {POPULAR_REACTIONS.map((ex) => (
      <div
        data-category={ex.category}
        class="example-card p-5 rounded-xl bg-white border border-[#ebebeb] hover:border-[#171717] transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.03)] flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-[#fafafa] text-[#4d4d4d] border border-[#ebebeb]">
              {ex.category}
            </span>
            <span class="text-[11px] font-mono text-[#8f8f8f]">
              {ex.difficulty}
            </span>
          </div>

          <h3 class="text-sm font-semibold text-[#171717] group-hover:text-[#0070f3] transition-colors">
            {ex.name}
          </h3>

          <div class="my-3 p-2.5 rounded-[6px] bg-[#fafafa] border border-[#ebebeb]/80 font-mono text-xs text-[#171717] overflow-x-auto">
            {ex.unbalanced}
          </div>

          <p class="text-xs text-[#8f8f8f] line-clamp-2 leading-relaxed">
            {ex.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[#ebebeb]/60 flex items-center justify-between">
          <span class="text-[11px] font-mono text-[#a1a1a1]">1-click solve</span>
          <button
            type="button"
            data-load-equation={ex.unbalanced}
            class="load-example-btn text-xs font-medium text-[#171717] hover:text-white bg-[#fafafa] hover:bg-[#171717] border border-[#ebebeb] hover:border-[#171717] px-3 py-1 rounded-[6px] transition-all flex items-center gap-1.5 shadow-[0px_1px_1px_rgba(0,0,0,0.02)]"
          >
            <span>Balance This</span>
            <span class="font-mono text-[10px]">→</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

