---
import { POPULAR_REACTIONS, REACTION_CATEGORIES } from '../lib/chemistry/examples';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="examples" class="mt-14 sm:mt-20 scroll-mt-20">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 sm:mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-[#171717] dark:bg-white shrink-0"></span>
        <span class="text-xs font-mono font-medium uppercase text-[#8f8f8f] dark:text-[#737373] tracking-wider">
          {t('examplesSection.eyebrow')}
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-[#ededed] tracking-tight sm:tracking-[-1.28px]">
        {t('examplesSection.title')}
      </h2>
      <p class="text-[13px] sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 max-w-xl leading-relaxed">
        {t('examplesSection.subtitle')}
      </p>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:max-w-full text-xs">
      {REACTION_CATEGORIES.map((cat, i) => (
        <button
          type="button"
          data-category={cat}
          class={`example-category-btn px-3.5 sm:px-3 py-2 sm:py-1.5 min-h-[36px] sm:min-h-0 rounded-full text-xs font-medium transition-all whitespace-nowrap shrink-0 cursor-pointer ${
            i === 0
              ? 'bg-[#171717] dark:bg-white text-white dark:text-black shadow-sm'
              : 'bg-white dark:bg-[#171717] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#2b2b2b] hover:border-[#171717] dark:hover:border-white'
          }`}
        >
          {cat === 'All' ? t('examplesSection.categoryAll') : cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Reactions Grid -->
  <div id="examples-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 sm:gap-4">
    {POPULAR_REACTIONS.map((ex) => (
      <div
        data-category={ex.category}
        class="example-card p-4 sm:p-5 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] hover:border-[#171717] dark:hover:border-white transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.03)] flex flex-col justify-between group"
      >
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-[11px] font-mono font-medium px-2 py-0.5 rounded-full bg-[#fafafa] dark:bg-[#1a1a1a] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#333333]">
              {ex.category}
            </span>
            <span class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373]">
              {ex.difficulty}
            </span>
          </div>

          <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed] group-hover:text-[#0070f3] dark:group-hover:text-[#60a5fa] transition-colors">
            {ex.name}
          </h3>

          <div class="my-3 p-2.5 rounded-[6px] bg-[#fafafa] dark:bg-[#171717] border border-[#ebebeb]/80 dark:border-[#2b2b2b] font-mono text-xs text-[#171717] dark:text-[#ededed] overflow-x-auto">
            {ex.unbalanced}
          </div>

          <p class="text-xs text-[#8f8f8f] dark:text-[#737373] line-clamp-2 leading-relaxed">
            {ex.description}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[#ebebeb]/60 dark:border-[#262626] flex items-center justify-between gap-2">
          <span class="text-[11px] font-mono text-[#a1a1a1] dark:text-[#525252]">1-click solve</span>
          <button
            type="button"
            data-load-equation={ex.unbalanced}
            class="load-example-btn text-xs font-medium text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black bg-[#fafafa] dark:bg-[#171717] hover:bg-[#171717] dark:hover:bg-white border border-[#ebebeb] dark:border-[#333333] hover:border-[#171717] dark:hover:border-white px-3.5 py-2 sm:px-3 sm:py-1 min-h-[36px] sm:min-h-0 rounded-[6px] transition-all flex items-center gap-1.5 shadow-[0px_1px_1px_rgba(0,0,0,0.02)] cursor-pointer whitespace-nowrap shrink-0"
          >
            <span>Balance This</span>
            <span class="font-mono text-[10px]">→</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>
