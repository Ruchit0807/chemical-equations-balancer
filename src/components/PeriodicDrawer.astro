---
import { ELEMENTS_DATA } from '../lib/chemistry/elements';

const categories = [
  { id: 'all', label: 'All Elements' },
  { id: 'diatomic-nonmetal', label: 'Nonmetals', color: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  { id: 'noble-gas', label: 'Noble Gases', color: 'bg-indigo-50 text-indigo-800 border-indigo-200' },
  { id: 'alkali-metal', label: 'Alkali Metals', color: 'bg-rose-50 text-rose-800 border-rose-200' },
  { id: 'alkaline-earth-metal', label: 'Alkaline Earth', color: 'bg-amber-50 text-amber-800 border-amber-200' },
  { id: 'metalloid', label: 'Metalloids', color: 'bg-teal-50 text-teal-800 border-teal-200' },
  { id: 'polyatomic-nonmetal', label: 'Polyatomic', color: 'bg-cyan-50 text-cyan-800 border-cyan-200' },
  { id: 'transition-metal', label: 'Transition Metals', color: 'bg-blue-50 text-blue-800 border-blue-200' },
  { id: 'post-transition-metal', label: 'Post-Transition', color: 'bg-purple-50 text-purple-800 border-purple-200' },
  { id: 'lanthanide', label: 'Lanthanides', color: 'bg-fuchsia-50 text-fuchsia-800 border-fuchsia-200' },
  { id: 'actinide', label: 'Actinides', color: 'bg-pink-50 text-pink-800 border-pink-200' }
];

// Most frequent chemistry elements for instant quick-bar
const frequentElements = [
  'H', 'C', 'N', 'O', 'F', 'Na', 'Mg', 'Al', 'Si', 'P', 'S', 'Cl', 'K', 'Ca', 'Cr', 'Mn', 'Fe', 'Cu', 'Zn', 'Br', 'Ag', 'I', 'Ba', 'Pb'
];
---

<div id="periodic-keypad-container" class="mt-4 border border-[#ebebeb] bg-white rounded-xl shadow-[0px_1px_1px_rgba(0,0,0,0.04)] overflow-hidden transition-all">
  <!-- Keypad Header / Toggle -->
  <div class="px-4 py-3 bg-[#fafafa] border-b border-[#ebebeb] flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#171717]"></span>
      <span class="text-xs font-mono font-medium uppercase text-[#171717] tracking-wider">
        Chemistry Keypad & Periodic Table
      </span>
      <span class="text-[11px] text-[#8f8f8f] hidden sm:inline">
        Tap elements or operators to build formulas directly
      </span>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="toggle-full-pt-btn"
        class="text-xs font-medium text-[#4d4d4d] hover:text-[#171717] bg-white border border-[#ebebeb] px-3 py-1 rounded-[6px] transition-colors flex items-center gap-1.5 shadow-[0px_1px_1px_rgba(0,0,0,0.04)]"
      >
        <span id="pt-btn-text">Open Full Periodic Table</span>
        <svg id="pt-btn-icon" class="w-3.5 h-3.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Row 1: Chemistry Quick Elements Bar -->
  <div class="p-3 bg-white border-b border-[#ebebeb]/60">
    <div class="text-[11px] font-mono text-[#8f8f8f] mb-2 uppercase tracking-wider flex items-center justify-between">
      <span>Common Elements</span>
      <span class="text-[10px] text-[#a1a1a1]">Click to insert at cursor</span>
    </div>
    <div class="flex flex-wrap gap-1.5">
      {frequentElements.map((sym) => {
        const el = ELEMENTS_DATA.find((e) => e.symbol === sym);
        return (
          <button
            type="button"
            data-insert={sym}
            class="keypad-insert-btn h-9 min-w-9 px-2.5 rounded-[6px] bg-[#fafafa] hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] hover:border-[#171717] font-mono font-medium text-xs flex flex-col items-center justify-center transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.03)]"
            title={`${el?.name} (Z=${el?.number}, ${el?.mass} g/mol)`}
          >
            <span class="text-[13px] font-semibold">{sym}</span>
            <span class="text-[9px] opacity-60 leading-none -mt-0.5">{el?.mass ? Math.round(el.mass) : ''}</span>
          </button>
        );
      })}
    </div>
  </div>

  <!-- Row 2: Chemistry Operator & Syntax Keypad -->
  <div class="p-3 bg-[#fafafa]/50 flex flex-wrap items-center gap-1.5 border-b border-[#ebebeb]/60">
    <div class="flex items-center gap-1 mr-2">
      <span class="text-[11px] font-mono text-[#8f8f8f] uppercase">Syntax:</span>
    </div>

    <!-- Arrow & Plus -->
    <button
      type="button"
      data-insert=" -> "
      class="keypad-insert-btn h-8 px-3 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-semibold transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.03)]"
      title="Reaction Arrow (yields)"
    >
      → (yields)
    </button>
    <button
      type="button"
      data-insert=" + "
      class="keypad-insert-btn h-8 px-3 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-semibold transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.03)]"
      title="Add species (+)"
    >
      +
    </button>
    <button
      type="button"
      data-insert="("
      class="keypad-insert-btn h-8 px-2.5 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-semibold transition-all"
    >
      (
    </button>
    <button
      type="button"
      data-insert=")"
      class="keypad-insert-btn h-8 px-2.5 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-semibold transition-all"
    >
      )
    </button>
    <button
      type="button"
      data-insert="·"
      class="keypad-insert-btn h-8 px-2.5 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-semibold transition-all"
      title="Hydrate dot (·)"
    >
      · (hydrate)
    </button>

    <div class="h-5 w-px bg-[#ebebeb] mx-1"></div>

    <!-- Common Subscripts / Numbers -->
    <div class="flex items-center gap-1">
      {['2', '3', '4', '5', '6', '8', '12'].map((num) => (
        <button
          type="button"
          data-insert={num}
          class="keypad-insert-btn h-8 w-8 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-medium transition-all"
        >
          {num}
        </button>
      ))}
    </div>

    <div class="h-5 w-px bg-[#ebebeb] mx-1"></div>

    <!-- Charges -->
    <div class="flex items-center gap-1">
      {['+', '-', '2+', '2-', '3+'].map((charge) => (
        <button
          type="button"
          data-insert={`^${charge}`}
          class="keypad-insert-btn h-8 px-2 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-xs font-medium transition-all"
          title={`Ionic Charge ${charge}`}
        >
          <sup>{charge}</sup>
        </button>
      ))}
    </div>

    <div class="h-5 w-px bg-[#ebebeb] mx-1"></div>

    <!-- Phases -->
    <div class="flex items-center gap-1">
      {['(s)', '(l)', '(g)', '(aq)'].map((phase) => (
        <button
          type="button"
          data-insert={` ${phase}`}
          class="keypad-insert-btn h-8 px-2 rounded-[6px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] font-mono text-[11px] font-medium transition-all"
          title={`Phase State ${phase}`}
        >
          {phase}
        </button>
      ))}
    </div>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        id="keypad-backspace-btn"
        class="h-8 px-2.5 rounded-[6px] bg-[#f2f2f2] hover:bg-[#e5e5e5] text-[#4d4d4d] border border-[#ebebeb] font-mono text-xs transition-colors flex items-center gap-1"
        title="Backspace"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414-6.414a2 2 0 011.414-.586H19a2 2 0 012 2v10a2 2 0 01-2 2h-8.172a2 2 0 01-1.414-.586L3 12z" />
        </svg>
        <span>Del</span>
      </button>
      <button
        type="button"
        id="keypad-clear-btn"
        class="h-8 px-2.5 rounded-[6px] bg-[#f2f2f2] hover:bg-rose-50 hover:text-rose-600 border border-[#ebebeb] font-mono text-xs text-[#4d4d4d] transition-colors"
        title="Clear entire equation"
      >
        Clear
      </button>
    </div>
  </div>

  <!-- Full Interactive Periodic Table Drawer (Expandable) -->
  <div id="full-periodic-table-drawer" class="hidden p-4 bg-[#fafafa] border-t border-[#ebebeb]">
    <!-- Search & Category Filters -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-4">
      <div class="relative flex-1 max-w-sm">
        <input
          type="text"
          id="element-search-input"
          placeholder="Search by element name, symbol (e.g. Fe, Gold), or Z..."
          class="w-full h-8 px-3 pl-8 text-xs bg-white border border-[#ebebeb] rounded-[6px] text-[#171717] focus:outline-none focus:border-[#171717] transition-all"
        />
        <svg class="w-3.5 h-3.5 text-[#8f8f8f] absolute left-2.5 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
        {categories.slice(0, 5).map((cat) => (
          <button
            type="button"
            data-category-filter={cat.id}
            class="category-filter-btn px-2.5 py-1 rounded-full text-[11px] font-medium bg-white text-[#4d4d4d] border border-[#ebebeb] hover:border-[#171717] transition-colors whitespace-nowrap"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Scrollable 118-Element Grid -->
    <div class="max-h-80 overflow-y-auto pr-1">
      <div id="elements-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 xl:grid-cols-10 gap-2">
        {ELEMENTS_DATA.map((el) => (
          <button
            type="button"
            data-insert={el.symbol}
            data-element-symbol={el.symbol.toLowerCase()}
            data-element-name={el.name.toLowerCase()}
            data-element-number={el.number}
            data-element-category={el.category}
            class="element-grid-card text-left p-2 rounded-[8px] bg-white hover:bg-[#171717] text-[#171717] hover:text-white border border-[#ebebeb] hover:border-[#171717] transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.02)] group flex flex-col justify-between h-18"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-[10px] font-mono opacity-60">{el.number}</span>
              <span class="text-[9px] font-mono opacity-60">{el.mass.toFixed(1)}</span>
            </div>
            <div>
              <div class="text-base font-semibold font-mono tracking-tight leading-none group-hover:translate-x-0.5 transition-transform">
                {el.symbol}
              </div>
              <div class="text-[10px] truncate opacity-75 mt-0.5">
                {el.name}
              </div>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

