---
import { ELEMENTS_DATA, type ElementInfo } from '../lib/chemistry/elements';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

// Helper to determine periodic table grid coordinates
function getElementGridPosition(el: ElementInfo): { row: number; col: number; isFBlock: boolean } {
  // Lanthanides: 57 to 71 -> Row 9, Col 3 to 17
  if (el.number >= 57 && el.number <= 71) {
    return { row: 9, col: el.number - 57 + 3, isFBlock: true };
  }
  // Actinides: 89 to 103 -> Row 10, Col 3 to 17
  if (el.number >= 89 && el.number <= 103) {
    return { row: 10, col: el.number - 89 + 3, isFBlock: true };
  }
  // Main table: periods 1 to 7, groups 1 to 18
  return { row: el.period, col: el.group, isFBlock: false };
}

// Category styles for clean Geist aesthetic in both light & dark mode
const categoryStyles: Record<string, string> = {
  'diatomic-nonmetal': 'bg-sky-50 dark:bg-sky-950/40 text-sky-900 dark:text-sky-200 border-sky-200 dark:border-sky-800 hover:border-sky-400',
  'noble-gas': 'bg-indigo-50 dark:bg-indigo-950/40 text-indigo-900 dark:text-indigo-200 border-indigo-200 dark:border-indigo-800 hover:border-indigo-400',
  'alkali-metal': 'bg-rose-50 dark:bg-rose-950/40 text-rose-900 dark:text-rose-200 border-rose-200 dark:border-rose-800 hover:border-rose-400',
  'alkaline-earth-metal': 'bg-amber-50 dark:bg-amber-950/40 text-amber-900 dark:text-amber-200 border-amber-200 dark:border-amber-800 hover:border-amber-400',
  'metalloid': 'bg-teal-50 dark:bg-teal-950/40 text-teal-900 dark:text-teal-200 border-teal-200 dark:border-teal-800 hover:border-teal-400',
  'polyatomic-nonmetal': 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-900 dark:text-cyan-200 border-cyan-200 dark:border-cyan-800 hover:border-cyan-400',
  'transition-metal': 'bg-blue-50 dark:bg-blue-950/40 text-blue-900 dark:text-blue-200 border-blue-200 dark:border-blue-800 hover:border-blue-400',
  'post-transition-metal': 'bg-purple-50 dark:bg-purple-950/40 text-purple-900 dark:text-purple-200 border-purple-200 dark:border-purple-800 hover:border-purple-400',
  'lanthanide': 'bg-fuchsia-50 dark:bg-fuchsia-950/40 text-fuchsia-900 dark:text-fuchsia-200 border-fuchsia-200 dark:border-fuchsia-800 hover:border-fuchsia-400',
  'actinide': 'bg-pink-50 dark:bg-pink-950/40 text-pink-900 dark:text-pink-200 border-pink-200 dark:border-pink-800 hover:border-pink-400',
  'unknown': 'bg-zinc-50 dark:bg-zinc-900 text-zinc-900 dark:text-zinc-200 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400'
};

// High-frequency elements for compact mobile view
const frequentElements = [
  'H', 'C', 'N', 'O', 'F', 'Na', 'Mg', 'Al', 'Si', 'P', 'S', 'Cl', 'K', 'Ca', 'Cr', 'Mn', 'Fe', 'Cu', 'Zn', 'Br', 'Ag', 'I', 'Ba', 'Pb'
];
const extraElements = ELEMENTS_DATA.filter((el) => !frequentElements.includes(el.symbol));
---

<div id="periodic-table-section" class="mt-4 border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] rounded-2xl shadow-[0px_1px_2px_rgba(0,0,0,0.03)] overflow-hidden transition-colors scroll-mt-20">
  <!-- Keypad & Table Header Tabs -->
  <div class="px-3.5 sm:px-4 py-3 bg-[#fafafa] dark:bg-[#171717] border-b border-[#ebebeb] dark:border-[#262626] flex flex-col sm:flex-row sm:flex-wrap sm:items-center justify-between gap-2.5 sm:gap-3">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 min-w-0">
      <span class="w-2 h-2 rounded-full bg-[#171717] dark:bg-white shrink-0"></span>
      <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] dark:text-[#ededed] tracking-wider leading-snug">
        {t('keypad.title')}
      </h3>
      <span class="hidden sm:inline-block text-[11px] text-[#8f8f8f] dark:text-[#737373]">
        {t('keypad.instruction')}
      </span>
    </div>

    <!-- View Switcher Tabs -->
    <div class="w-full sm:w-auto grid grid-cols-2 sm:flex items-center gap-1 sm:gap-1.5 bg-[#f2f2f2] dark:bg-[#1f1f1f] p-1 rounded-[8px] border border-[#ebebeb] dark:border-[#2b2b2b] shrink-0">
      <button
        type="button"
        id="view-table-btn"
        class="text-[11px] sm:text-xs font-medium px-2.5 sm:px-3 py-2 sm:py-1 rounded-[6px] bg-white dark:bg-[#121212] text-[#171717] dark:text-white shadow-[0px_1px_1px_rgba(0,0,0,0.04)] transition-all cursor-pointer leading-tight text-center"
      >
        {t('keypad.tabTable')}
      </button>
      <button
        type="button"
        id="view-compact-btn"
        class="text-[11px] sm:text-xs font-medium px-2.5 sm:px-3 py-2 sm:py-1 rounded-[6px] text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white transition-all cursor-pointer leading-tight text-center"
      >
        {t('keypad.tabKeypad')}
      </button>
    </div>
  </div>

  <!-- Chemical Operator & Syntax Ribbon (Always Accessible) -->
  <div class="p-2.5 sm:p-3 bg-white dark:bg-[#121212] border-b border-[#ebebeb] dark:border-[#262626] flex flex-wrap items-center gap-1.5 text-xs">
    <div class="flex items-center gap-1 mr-0.5 text-[#8f8f8f] dark:text-[#737373] font-mono text-[11px] uppercase">
      <span>Insert:</span>
    </div>

    <!-- Arrow & Plus -->
    <button
      type="button"
      data-insert=" -> "
      class="chem-key-btn h-9 sm:h-8 px-3 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-semibold transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.02)] cursor-pointer active:scale-95"
      title="Yields Arrow (->)"
    >
      → (yields)
    </button>
    <button
      type="button"
      data-insert=" + "
      class="chem-key-btn h-9 sm:h-8 px-3 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-semibold transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.02)] cursor-pointer active:scale-95"
      title="Plus sign (+)"
    >
      +
    </button>
    <button
      type="button"
      data-insert="("
      class="chem-key-btn h-9 sm:h-8 min-w-[36px] sm:w-8 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-semibold transition-all cursor-pointer active:scale-95"
    >
      (
    </button>
    <button
      type="button"
      data-insert=")"
      class="chem-key-btn h-9 sm:h-8 min-w-[36px] sm:w-8 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-semibold transition-all cursor-pointer active:scale-95"
    >
      )
    </button>
    <button
      type="button"
      data-insert="·"
      class="chem-key-btn h-9 sm:h-8 px-2.5 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-semibold transition-all cursor-pointer active:scale-95"
      title="Hydrate dot (·)"
    >
      · (hydrate)
    </button>

    <div class="hidden sm:block h-5 w-px bg-[#ebebeb] dark:bg-[#333333] mx-1"></div>

    <!-- Numbers / Subscripts -->
    <div class="flex items-center gap-1">
      {['2', '3', '4', '5', '6', '8'].map((num) => (
        <button
          type="button"
          data-insert={num}
          class="chem-key-btn h-9 sm:h-8 min-w-[36px] sm:w-8 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-medium transition-all cursor-pointer active:scale-95"
        >
          {num}
        </button>
      ))}
    </div>

    <div class="hidden sm:block h-5 w-px bg-[#ebebeb] dark:bg-[#333333] mx-1"></div>

    <!-- Charges -->
    <div class="flex items-center gap-1">
      {['+', '-', '2+', '2-', '3+'].map((charge) => (
        <button
          type="button"
          data-insert={`^${charge}`}
          class="chem-key-btn h-9 sm:h-8 min-w-[34px] sm:min-w-0 px-2 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-xs font-medium transition-all cursor-pointer active:scale-95"
          title={`Charge ${charge}`}
        >
          <sup>{charge}</sup>
        </button>
      ))}
    </div>

    <div class="hidden sm:block h-5 w-px bg-[#ebebeb] dark:bg-[#333333] mx-1"></div>

    <!-- States of Matter -->
    <div class="flex items-center gap-1">
      {['(s)', '(l)', '(g)', '(aq)'].map((st) => (
        <button
          type="button"
          data-insert={` ${st}`}
          class="chem-key-btn h-9 sm:h-8 px-2.5 sm:px-2 rounded-[6px] bg-[#fafafa] dark:bg-[#1a1a1a] hover:bg-[#171717] dark:hover:bg-white text-[#171717] dark:text-[#ededed] hover:text-white dark:hover:text-black border border-[#ebebeb] dark:border-[#333333] font-mono text-[11px] font-medium transition-all cursor-pointer active:scale-95"
          title={`Phase state ${st}`}
        >
          {st}
        </button>
      ))}
    </div>

    <!-- Delete and Clear -->
    <div class="w-full sm:w-auto sm:ml-auto flex items-center justify-end gap-1.5 pt-2 sm:pt-0 mt-0.5 sm:mt-0 border-t sm:border-t-0 border-[#f2f2f2] dark:border-[#262626]">
      <button
        type="button"
        id="pt-backspace-btn"
        class="h-9 sm:h-8 px-3 sm:px-2.5 rounded-[6px] bg-[#f2f2f2] dark:bg-[#1f1f1f] hover:bg-[#e5e5e5] dark:hover:bg-[#2b2b2b] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#333333] font-mono text-xs transition-colors flex items-center gap-1 cursor-pointer active:scale-95"
        title="Backspace"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414-6.414a2 2 0 011.414-.586H19a2 2 0 012 2v10a2 2 0 01-2 2h-8.172a2 2 0 01-1.414-.586L3 12z" />
        </svg>
        <span>{t('keypad.backspaceBtn')}</span>
      </button>
      <button
        type="button"
        id="pt-clear-btn"
        class="h-9 sm:h-8 px-3 sm:px-2.5 rounded-[6px] bg-[#f2f2f2] dark:bg-[#1f1f1f] hover:bg-rose-50 dark:hover:bg-rose-950/40 hover:text-rose-600 dark:hover:text-rose-400 border border-[#ebebeb] dark:border-[#333333] font-mono text-xs text-[#4d4d4d] dark:text-[#a1a1a1] transition-colors cursor-pointer active:scale-95"
        title="Clear entire equation"
      >
        {t('keypad.clearBtn')}
      </button>
    </div>
  </div>

  <!-- Shared Element Search & Insert Toast Bar -->
  <div class="px-3 sm:px-4 pt-3 bg-[#fafafa] dark:bg-[#0f0f0f] flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 text-xs transition-colors">
    <div class="flex items-center gap-2 min-w-0 flex-1 sm:flex-initial">
      <input
        type="text"
        id="element-table-filter"
        placeholder={t('keypad.filterPlaceholder')}
        class="flex-1 min-w-0 sm:flex-none sm:w-72 h-10 sm:h-8 px-3 text-base sm:text-xs font-mono bg-white dark:bg-[#171717] border border-[#ebebeb] dark:border-[#333333] rounded-[6px] text-[#171717] dark:text-[#ededed] placeholder:text-[#8f8f8f] focus:outline-none focus:border-[#171717] dark:focus:border-white"
      />
      <span id="insert-toast" class="hidden shrink-0 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-1 rounded border border-emerald-200 dark:border-emerald-800">
        Inserted!
      </span>
    </div>

    <!-- Category Legend Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pb-0.5 text-[11px]">
      <span class="shrink-0 px-2 py-0.5 rounded border bg-sky-50 dark:bg-sky-950/50 text-sky-800 dark:text-sky-300 border-sky-200 dark:border-sky-800">Nonmetals</span>
      <span class="shrink-0 px-2 py-0.5 rounded border bg-rose-50 dark:bg-rose-950/50 text-rose-800 dark:text-rose-300 border-rose-200 dark:border-rose-800">Alkali</span>
      <span class="shrink-0 px-2 py-0.5 rounded border bg-amber-50 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300 border-amber-200 dark:border-amber-800">Alk. Earth</span>
      <span class="shrink-0 px-2 py-0.5 rounded border bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border-blue-200 dark:border-blue-800">Transition</span>
      <span class="shrink-0 px-2 py-0.5 rounded border bg-indigo-50 dark:bg-indigo-950/50 text-indigo-800 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800">Noble Gas</span>
    </div>
  </div>

  <!-- VIEW 1: Authentic 18-Column IUPAC Periodic Table Layout -->
  <div id="full-periodic-table-view" class="p-3 sm:p-4 bg-[#fafafa] dark:bg-[#0f0f0f] transition-colors">
    <div class="md:hidden text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] mb-2 flex items-center justify-between">
      <span>Swipe horizontally to explore all 18 groups ↔</span>
    </div>

    <!-- 18-Column Interactive Periodic Table Grid Container -->
    <div class="overflow-x-auto pb-2 -mx-1 px-1">
      <div
        id="periodic-grid"
        class="grid gap-1 min-w-[710px] md:min-w-0 select-none"
        style="grid-template-columns: repeat(18, minmax(35px, 1fr)); grid-template-rows: repeat(10, minmax(44px, 1fr));"
      >
        <!-- Group Numbers Header Row (1 to 18) -->
        {Array.from({ length: 18 }, (_, i) => (
          <div
            class="text-[9px] font-mono text-center text-[#8f8f8f] dark:text-[#737373] pb-0.5"
            style={`grid-column: ${i + 1}; grid-row: 1;`}
          >
            {i + 1}
          </div>
        ))}

        <!-- Elements Placement -->
        {ELEMENTS_DATA.map((el) => {
          const pos = getElementGridPosition(el);
          const gridRow = pos.row + 1; // +1 due to group header row
          const gridCol = pos.col;
          const catClass = categoryStyles[el.category] || categoryStyles['unknown'];

          return (
            <button
              type="button"
              data-insert={el.symbol}
              data-symbol={el.symbol.toLowerCase()}
              data-name={el.name.toLowerCase()}
              data-number={el.number}
              style={`grid-column: ${gridCol}; grid-row: ${gridRow};`}
              class={`element-cell p-1 rounded-[6px] border flex flex-col justify-between items-center transition-all duration-150 cursor-pointer active:scale-95 shadow-[0px_1px_1px_rgba(0,0,0,0.02)] ${catClass}`}
              title={`${el.name} (Atomic #${el.number}, Mass: ${el.mass} g/mol)`}
            >
              <div class="w-full flex items-center justify-between text-[8px] font-mono leading-none opacity-70">
                <span>{el.number}</span>
              </div>
              <div class="text-[13px] font-bold font-mono tracking-tight leading-none my-0.5">
                {el.symbol}
              </div>
              <div class="text-[8px] font-mono leading-none opacity-75 truncate max-w-full">
                {el.mass < 100 ? el.mass.toFixed(1) : Math.round(el.mass)}
              </div>
            </button>
          );
        })}

        <!-- Placeholder cell for Lanthanides (57-71 in Period 6, Group 3) -->
        <div
          style="grid-column: 3; grid-row: 7;"
          class="p-1 rounded-[6px] border border-dashed border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#171717] flex flex-col justify-center items-center text-center text-[9px] font-mono text-[#8f8f8f]"
        >
          <span>57-71</span>
          <span class="text-[8px]">La-Lu</span>
        </div>

        <!-- Placeholder cell for Actinides (89-103 in Period 7, Group 3) -->
        <div
          style="grid-column: 3; grid-row: 8;"
          class="p-1 rounded-[6px] border border-dashed border-[#ebebeb] dark:border-[#333333] bg-[#fafafa] dark:bg-[#171717] flex flex-col justify-center items-center text-center text-[9px] font-mono text-[#8f8f8f]"
        >
          <span>89-103</span>
          <span class="text-[8px]">Ac-Lr</span>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Compact Quick-Keypad View -->
  <div id="compact-keypad-view" class="hidden p-3 sm:p-4 bg-[#fafafa] dark:bg-[#0f0f0f] transition-colors">
    <div id="compact-keypad-heading" class="text-[11px] font-mono text-[#8f8f8f] dark:text-[#737373] mb-2 uppercase tracking-wider">
      {t('keypad.commonElementsLabel')}:
    </div>
    <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-12 gap-1.5 sm:gap-2">
      {frequentElements.map((sym) => {
        const el = ELEMENTS_DATA.find((e) => e.symbol === sym);
        const catClass = el ? categoryStyles[el.category] : '';
        return (
          <button
            type="button"
            data-insert={sym}
            data-symbol={sym.toLowerCase()}
            data-name={(el?.name || '').toLowerCase()}
            data-number={el?.number}
            class={`compact-element-cell min-h-[56px] p-2 rounded-[8px] border text-center transition-all cursor-pointer active:scale-95 shadow-[0px_1px_1px_rgba(0,0,0,0.02)] flex flex-col justify-between items-center ${catClass}`}
            title={`${el?.name} (${el?.mass} g/mol)`}
          >
            <div class="text-[10px] font-mono opacity-70 leading-none">{el?.number}</div>
            <div class="text-base font-bold font-mono my-0.5 leading-none">{sym}</div>
            <div class="text-[10px] font-mono opacity-75 truncate w-full">{el?.name}</div>
          </button>
        );
      })}
      {extraElements.map((el) => {
        const catClass = categoryStyles[el.category] || categoryStyles['unknown'];
        return (
          <button
            type="button"
            data-insert={el.symbol}
            data-symbol={el.symbol.toLowerCase()}
            data-name={el.name.toLowerCase()}
            data-number={el.number}
            class={`hidden compact-extra-cell min-h-[56px] p-2 rounded-[8px] border text-center transition-all cursor-pointer active:scale-95 shadow-[0px_1px_1px_rgba(0,0,0,0.02)] flex-col justify-between items-center ${catClass}`}
            title={`${el.name} (${el.mass} g/mol)`}
          >
            <div class="text-[10px] font-mono opacity-70 leading-none">{el.number}</div>
            <div class="text-base font-bold font-mono my-0.5 leading-none">{el.symbol}</div>
            <div class="text-[10px] font-mono opacity-75 truncate w-full">{el.name}</div>
          </button>
        );
      })}
    </div>
  </div>
</div>

<!-- Default to Compact Quick-Keypad on Mobile (< 768px) before first paint -->
<script is:inline>
  (function () {
    if (window.innerWidth < 768) {
      var fullView = document.getElementById('full-periodic-table-view');
      var compactView = document.getElementById('compact-keypad-view');
      var tableBtn = document.getElementById('view-table-btn');
      var compactBtn = document.getElementById('view-compact-btn');
      if (fullView && compactView && tableBtn && compactBtn) {
        fullView.classList.add('hidden');
        compactView.classList.remove('hidden');
        compactBtn.classList.add('bg-white', 'dark:bg-[#121212]', 'text-[#171717]', 'dark:text-white', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
        compactBtn.classList.remove('text-[#4d4d4d]', 'dark:text-[#a1a1a1]');
        tableBtn.classList.remove('bg-white', 'dark:bg-[#121212]', 'text-[#171717]', 'dark:text-white', 'shadow-[0px_1px_1px_rgba(0,0,0,0.04)]');
        tableBtn.classList.add('text-[#4d4d4d]', 'dark:text-[#a1a1a1]');
      }
    }
  })();
</script>
