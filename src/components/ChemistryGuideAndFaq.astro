---
// ChemistryGuideAndFaq.astro
// Educational chemical reaction classifications and SEO-optimized FAQ with JSON-LD FAQPage schema.
import { reactionGuideTranslations } from '../i18n/reactions';
import { faqTranslations, getFaqJsonLd } from '../i18n/faq';
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const reactionGuide = reactionGuideTranslations[lang] || reactionGuideTranslations.en;
const faqSection = faqTranslations[lang] || faqTranslations.en;
const faqJsonLd = getFaqJsonLd(lang);
---

<section id="faq" class="mt-24 scroll-mt-20">
  <!-- JSON-LD FAQPage Schema Markup for SEO in current language -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd, null, 2)} />

  <!-- Educational Reaction Guide Grid -->
  <div class="mb-20">
    <div class="flex items-center gap-2 mb-1.5">
      <span class="w-2 h-2 rounded-full bg-[#171717] dark:bg-white"></span>
      <span class="text-xs font-mono font-medium uppercase text-[#8f8f8f] dark:text-[#737373] tracking-wider">
        {reactionGuide.eyebrow}
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-[#ededed] tracking-[-1.28px]">
      {reactionGuide.title}
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 max-w-xl">
      {reactionGuide.subtitle}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
      {reactionGuide.items.map((t) => (
        <div class="p-5 rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-[0px_1px_1px_rgba(0,0,0,0.03)] flex flex-col justify-between transition-colors">
          <div>
            <div class="text-[11px] font-mono font-medium text-[#0070f3] dark:text-[#60a5fa] bg-[#d3e5ff]/50 dark:bg-[#1e3a8a]/40 px-2 py-0.5 rounded-full inline-block mb-2 border border-[#0070f3]/20 dark:border-[#3b82f6]/30">
              {t.formula}
            </div>
            <h3 class="text-sm font-semibold text-[#171717] dark:text-[#ededed]">{t.name}</h3>
            <p class="text-xs text-[#8f8f8f] dark:text-[#737373] mt-1.5 leading-relaxed">{t.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-[#ebebeb]/60 dark:border-[#262626] flex items-center justify-between text-xs font-mono text-[#4d4d4d] dark:text-[#a1a1a1]">
            <span class="text-[11px] text-[#8f8f8f] dark:text-[#737373]">Example:</span>
            <span class="font-semibold text-[#171717] dark:text-white">{t.example}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Primary Chemistry FAQ Section -->
  <div>
    <div class="flex items-center gap-2 mb-1.5">
      <span class="w-2 h-2 rounded-full bg-[#171717] dark:bg-white"></span>
      <span class="text-xs font-mono font-medium uppercase text-[#8f8f8f] dark:text-[#737373] tracking-wider">
        {faqSection.eyebrow}
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-semibold text-[#171717] dark:text-[#ededed] tracking-[-1.28px]">
      {faqSection.title}
    </h2>
    <p class="text-xs sm:text-sm text-[#4d4d4d] dark:text-[#a1a1a1] mt-1 max-w-xl">
      {faqSection.subtitle}
    </p>

    <!-- FAQ Accordion List -->
    <div class="mt-8 space-y-3">
      {faqSection.faqs.map((faq, index) => (
        <div class="faq-card border border-[#ebebeb] dark:border-[#262626] bg-white dark:bg-[#121212] rounded-xl overflow-hidden transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.02)]">
          <button
            type="button"
            class="faq-question-btn w-full px-5 py-4 text-left flex items-center justify-between gap-4 hover:bg-[#fafafa] dark:hover:bg-[#171717] transition-colors cursor-pointer"
            aria-expanded="false"
            data-index={index}
          >
            <div class="flex items-center gap-3">
              <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-full bg-[#f2f2f2] dark:bg-[#1f1f1f] text-[#4d4d4d] dark:text-[#a1a1a1] border border-[#ebebeb] dark:border-[#333333]">
                {faq.category}
              </span>
              <span class="text-sm font-semibold text-[#171717] dark:text-[#ededed]">
                {faq.question}
              </span>
            </div>
            <svg class="faq-chevron w-4 h-4 text-[#8f8f8f] dark:text-[#737373] shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="faq-answer hidden px-5 pb-5 pt-1 text-xs text-[#4d4d4d] dark:text-[#a1a1a1] leading-relaxed border-t border-[#ebebeb]/60 dark:border-[#262626] prose prose-xs dark:prose-invert max-w-none">
            <Fragment set:html={faq.acceptedAnswer} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupFaqAccordion() {
    const btns = document.querySelectorAll('.faq-question-btn');
    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.faq-card');
        if (!card) return;
        const answer = card.querySelector('.faq-answer');
        const chevron = card.querySelector('.faq-chevron');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          answer?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          answer?.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
        }
      });
    });
  }

  setupFaqAccordion();
  document.addEventListener('astro:page-load', setupFaqAccordion);
</script>
