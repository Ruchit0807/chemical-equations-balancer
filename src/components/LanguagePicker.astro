---
import { languages, type Lang } from '../i18n/ui';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  currentLang: Lang;
  currentPath?: string;
  variant?: 'header' | 'footer';
}

const { currentLang = 'en', currentPath = '/', variant = 'header' } = Astro.props;
const currentLabel = languages[currentLang] || languages.en;
---

{variant === 'header' ? (
  <div class="relative inline-block text-left" id="lang-picker-dropdown">
    <button
      type="button"
      id="lang-picker-btn"
      class="h-9 sm:h-8 px-2 sm:px-2.5 rounded-[6px] border border-[#ebebeb] dark:border-[#333333] bg-white dark:bg-[#171717] text-[#4d4d4d] dark:text-[#ededed] hover:border-[#171717] dark:hover:border-white flex items-center gap-1 sm:gap-1.5 text-xs font-medium transition-all shadow-[0px_1px_1px_rgba(0,0,0,0.04)] cursor-pointer shrink-0"
      aria-expanded="false"
      aria-haspopup="true"
      title={`Select Language (${currentLabel})`}
    >
      <!-- Globe Icon -->
      <svg class="w-3.5 h-3.5 text-[#8f8f8f] dark:text-[#737373] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="sm:hidden uppercase font-mono text-[11px]">{currentLang}</span>
      <span class="hidden sm:inline">{currentLabel}</span>
      <svg class="w-3 h-3 text-[#8f8f8f] dark:text-[#737373] transition-transform shrink-0" id="lang-picker-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>

    <!-- Dropdown Menu -->
    <div
      id="lang-picker-menu"
      class="hidden absolute right-0 mt-1.5 w-44 max-w-[calc(100vw-1.5rem)] rounded-xl bg-white dark:bg-[#121212] border border-[#ebebeb] dark:border-[#262626] shadow-lg py-1 z-50 transition-all font-sans text-xs"
      role="menu"
      aria-orientation="vertical"
    >
      {Object.entries(languages).map(([code, label]) => {
        const translatePath = useTranslatedPath(code as Lang);
        const href = translatePath(currentPath);
        const isActive = code === currentLang;

        return (
          <a
            href={href}
            role="menuitem"
            class={`flex items-center justify-between px-3.5 py-2.5 sm:py-2 hover:bg-[#fafafa] dark:hover:bg-[#1a1a1a] transition-colors ${
              isActive
                ? 'font-semibold text-[#0070f3] dark:text-[#60a5fa] bg-[#0070f3]/5 dark:bg-[#0070f3]/10'
                : 'text-[#4d4d4d] dark:text-[#a1a1a1]'
            }`}
          >
            <span>{label}</span>
            {isActive && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3] dark:bg-[#60a5fa]"></span>
            )}
          </a>
        );
      })}
    </div>
  </div>
) : (
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="text-[#8f8f8f] dark:text-[#737373] font-mono text-[11px] mr-1">Language:</span>
    {Object.entries(languages).map(([code, label]) => {
      const translatePath = useTranslatedPath(code as Lang);
      const href = translatePath(currentPath);
      const isActive = code === currentLang;

      return (
        <a
          href={href}
          class={`px-2.5 py-1.5 sm:px-2 sm:py-0.5 rounded text-xs sm:text-[11px] font-medium transition-colors ${
            isActive
              ? 'bg-[#171717] dark:bg-white text-white dark:text-black font-semibold'
              : 'text-[#4d4d4d] dark:text-[#a1a1a1] hover:text-[#171717] dark:hover:text-white bg-[#f2f2f2] dark:bg-[#1f1f1f]'
          }`}
        >
          {label}
        </a>
      );
    })}
  </div>
)}

<script>
  function setupLangDropdown() {
    const btn = document.getElementById('lang-picker-btn');
    const menu = document.getElementById('lang-picker-menu');
    const chevron = document.getElementById('lang-picker-chevron');
    const container = document.getElementById('lang-picker-dropdown');

    if (!btn || !menu || !chevron || !container) return;

    const toggleMenu = () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        chevron.classList.add('rotate-180');
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        chevron.classList.remove('rotate-180');
      }
    };

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        chevron.classList.remove('rotate-180');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        chevron.classList.remove('rotate-180');
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:page-load', setupLangDropdown);
</script>

