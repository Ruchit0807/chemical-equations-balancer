---
// StoichiometryPlayground component
---

<div id="stoichiometry-section" class="mt-8 border border-[#ebebeb] bg-white rounded-xl shadow-[0px_1px_1px_rgba(0,0,0,0.04)] overflow-hidden">
  <!-- Section Header -->
  <div class="px-6 py-4 bg-[#fafafa] border-b border-[#ebebeb] flex flex-wrap items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#0070f3]"></span>
        <h3 class="text-xs font-mono font-semibold uppercase text-[#171717] tracking-wider">
          Interactive Stoichiometric Matrix
        </h3>
        <span class="text-[11px] font-mono text-[#0070f3] bg-[#d3e5ff]/60 px-2 py-0.5 rounded-full border border-[#0070f3]/20">
          Live Proportional Engine
        </span>
      </div>
      <p class="text-xs text-[#8f8f8f] mt-0.5">
        Change the quantity or unit for any compound below. All other reactants and products will instantly recalculate in stoichiometric balance.
      </p>
    </div>

    <!-- Mode Switch: Proportional vs Limiting Reagent -->
    <div class="flex items-center gap-1 bg-[#f2f2f2] p-1 rounded-[8px] border border-[#ebebeb]">
      <button
        type="button"
        id="mode-proportional-btn"
        class="stoich-mode-tab text-xs font-medium px-3 py-1 rounded-[6px] bg-white text-[#171717] shadow-[0px_1px_1px_rgba(0,0,0,0.04)] transition-all"
      >
        Proportional Solver
      </button>
      <button
        type="button"
        id="mode-limiting-btn"
        class="stoich-mode-tab text-xs font-medium px-3 py-1 rounded-[6px] text-[#4d4d4d] hover:text-[#171717] transition-all"
      >
        Limiting Reagent & % Yield
      </button>
    </div>
  </div>

  <!-- Mode 1: Proportional Stoichiometry Table View -->
  <div id="proportional-view" class="p-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="border-b border-[#ebebeb] text-[#8f8f8f] font-mono uppercase text-[11px]">
            <th class="pb-3 font-medium">Role</th>
            <th class="pb-3 font-medium">Compound</th>
            <th class="pb-3 font-medium">Mole Ratio</th>
            <th class="pb-3 font-medium">Molar Mass</th>
            <th class="pb-3 font-medium min-w-48">Input / Calculated Amount</th>
            <th class="pb-3 font-medium">Moles (mol)</th>
            <th class="pb-3 font-medium">Mass (g)</th>
            <th class="pb-3 font-medium">Gas at STP (L)</th>
          </tr>
        </thead>
        <tbody id="stoichiometry-tbody" class="divide-y divide-[#ebebeb]/70">
          <!-- Populated dynamically via JS -->
        </tbody>
      </table>
    </div>

    <div class="mt-4 pt-3 border-t border-[#ebebeb] flex flex-wrap items-center justify-between text-xs text-[#8f8f8f] font-mono">
      <div>
        <span>Standard Temperature & Pressure (STP): 0°C, 1 atm • 1 mol ideal gas = 22.414 L</span>
      </div>
      <div>
        <span>Avogadro's constant: 6.022 × 10²³ particles/mol</span>
      </div>
    </div>
  </div>

  <!-- Mode 2: Limiting Reagent & % Yield View -->
  <div id="limiting-view" class="hidden p-6 bg-[#fafafa]/50">
    <div class="mb-5">
      <h4 class="text-sm font-semibold text-[#171717]">
        Limiting Reactant & Theoretical Yield Calculator
      </h4>
      <p class="text-xs text-[#8f8f8f] mt-0.5">
        Enter the available quantities for multiple reactants. The algorithm determines which substance will be completely consumed first and calculates excess unreacted reagents.
      </p>
    </div>

    <!-- Limiting Reactant Inputs Grid -->
    <div id="limiting-reactants-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
      <!-- Populated dynamically via JS -->
    </div>

    <!-- Limiting Reagent Results Banner & Cards -->
    <div id="limiting-results-container" class="space-y-4">
      <!-- Populated dynamically via JS -->
    </div>

    <!-- Optional Percent Yield Calculator Box -->
    <div class="mt-6 p-4 rounded-xl bg-white border border-[#ebebeb] shadow-[0px_1px_1px_rgba(0,0,0,0.03)]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono uppercase font-semibold text-[#171717] tracking-wider">
            Percent Yield Calculator (%)
          </span>
          <p class="text-xs text-[#8f8f8f] mt-0.5">
            If you conducted this lab experiment, enter your actual isolated mass of product to compute the reaction efficiency.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <label for="actual-yield-input" class="text-xs font-mono text-[#4d4d4d]">Actual Yield:</label>
            <input
              type="number"
              id="actual-yield-input"
              step="any"
              placeholder="e.g. 18.5"
              class="w-24 h-8 px-2.5 bg-[#fafafa] border border-[#ebebeb] rounded-[6px] text-xs font-mono text-[#171717] focus:outline-none focus:border-[#171717]"
            />
            <span class="text-xs text-[#8f8f8f] font-mono">grams</span>
          </div>

          <div id="percent-yield-badge" class="hidden text-xs font-mono font-semibold px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            Yield: --%
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

